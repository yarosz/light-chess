<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug builds only (src/debug, which Light's builder never extracts): plain HTTP to a local Relay,
  `wrangler dev` on this machine, reached as 127.0.0.1 from the JVM and as 10.0.2.2 from the Android
  emulator (decision log W8). Everything else stays HTTPS-only, and release builds allow no cleartext.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
