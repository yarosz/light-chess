<?xml version="1.0" encoding="utf-8"?>
<!--
  Merged into debug builds only: the network security config that lets a debug build reach a local
  Relay over plain HTTP (res/xml/network_security_config.xml, decision log W8). The main manifest is
  generated by Light's plugin from tool/lighttool.toml; release builds get nothing from here.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:networkSecurityConfig="@xml/network_security_config" />
</manifest>
